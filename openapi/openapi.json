{
  "openapi": "3.1.0",
  "info": {
    "title": "robi",
    "description": "I/O behind the Robi loop: model providers and the local session API",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/chat_sessions": {
      "get": {
        "tags": [
          "chat_session"
        ],
        "operationId": "list_chat_sessions",
        "parameters": [
          {
            "name": "workspace_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat sessions listed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatSession"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chat_session"
        ],
        "operationId": "create_chat_session",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChatSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Chat session created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat_sessions/{id}": {
      "get": {
        "tags": [
          "chat_session"
        ],
        "operationId": "get_chat_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat session found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "chat_session"
        ],
        "operationId": "delete_chat_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Chat session deleted"
          }
        }
      },
      "patch": {
        "tags": [
          "chat_session"
        ],
        "operationId": "update_chat_session",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateChatSession"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Chat session updated",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatSession"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/chat_sessions/{id}/messages": {
      "get": {
        "tags": [
          "chat_message"
        ],
        "operationId": "list_chat_messages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat messages listed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ChatMessage"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "chat_message"
        ],
        "operationId": "submit_instruction",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitInstruction"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Instruction accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedInstruction"
                }
              }
            }
          },
          "409": {
            "description": "Chat session is awaiting approval"
          }
        }
      }
    },
    "/api/v1/chat_sessions/{id}/messages/{message_id}": {
      "get": {
        "tags": [
          "chat_message"
        ],
        "operationId": "get_chat_message",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "message_id",
            "in": "path",
            "description": "Chat message id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Chat message",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatMessage"
                }
              }
            }
          },
          "404": {
            "description": "Chat session or message is missing"
          }
        }
      }
    },
    "/api/v1/chat_sessions/{id}/tool_calls/{call_id}": {
      "post": {
        "tags": [
          "chat_message"
        ],
        "operationId": "decide_tool_call",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Chat session id",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "call_id",
            "in": "path",
            "description": "Tool call id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecideToolCall"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Decision accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedInstruction"
                }
              }
            }
          },
          "409": {
            "description": "Chat session is running"
          }
        }
      }
    },
    "/api/v1/events/stream": {
      "get": {
        "tags": [
          "events"
        ],
        "operationId": "stream_events",
        "parameters": [
          {
            "name": "event_types",
            "in": "query",
            "description": "Repeated. When non-empty, only these CloudEvents types are sent.",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          {
            "name": "session_id",
            "in": "query",
            "description": "When set, only envelopes whose subject is this session.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "CloudEvents JSON as server-sent events. Each frame is `id`, `event`, and `data`.",
            "content": {
              "text/event-stream": {}
            }
          },
          "400": {
            "description": "session_id is not a UUID"
          }
        }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": [],
        "operationId": "health_check",
        "responses": {
          "200": {
            "description": "Health check",
            "content": {
              "text/plain": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/models": {
      "get": {
        "tags": [
          "models"
        ],
        "operationId": "list_models",
        "responses": {
          "200": {
            "description": "Tool-capable models the provider can drive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogModel"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/settings/{key}": {
      "get": {
        "tags": [
          "settings"
        ],
        "operationId": "get_setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Setting key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Setting. An unset key with a default is stored, then returned. An unset key with no default has a null value. Secret values are omitted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettingResponse"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "settings"
        ],
        "operationId": "set_setting",
        "parameters": [
          {
            "name": "key",
            "in": "path",
            "description": "Setting key",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SetSetting"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": "Setting stored"
          }
        }
      }
    },
    "/api/v1/workspaces": {
      "get": {
        "tags": [
          "workspace"
        ],
        "operationId": "list_workspaces",
        "responses": {
          "200": {
            "description": "Workspaces listed",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Workspace"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "workspace"
        ],
        "operationId": "create_workspace",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateWorkspace"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Workspace already open for this root",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          },
          "201": {
            "description": "Workspace created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workspaces/{id}": {
      "get": {
        "tags": [
          "workspace"
        ],
        "operationId": "get_workspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Workspace"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "workspace"
        ],
        "operationId": "delete_workspace",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Workspace id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Workspace deleted"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AcceptedInstruction": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "CatalogModel": {
        "type": "object",
        "required": [
          "id",
          "display_name"
        ],
        "properties": {
          "display_name": {
            "type": "string"
          },
          "id": {
            "type": "string"
          }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": [
          "id",
          "role",
          "content",
          "tool_calls"
        ],
        "properties": {
          "content": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "tool_call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "tool_calls": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ChatToolCall"
            }
          }
        }
      },
      "ChatSession": {
        "type": "object",
        "required": [
          "id",
          "workspace_id",
          "path_allow_read",
          "path_allow_write",
          "path_deny_read",
          "path_deny_write",
          "model_config",
          "created_at",
          "updated_at",
          "last_used_at",
          "has_pending_agent"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "has_pending_agent": {
            "type": "boolean",
            "description": "True while this session's actor is running. Read from memory, not the database."
          },
          "id": {
            "type": "string"
          },
          "last_used_at": {
            "type": "string"
          },
          "model_config": {
            "$ref": "#/components/schemas/ModelConfigBody"
          },
          "path_allow_read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_allow_write": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_deny_read": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "path_deny_write": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Absent until the model names the chat session after the first turn, or a\ncreate/rename supplies one."
          },
          "updated_at": {
            "type": "string"
          },
          "workspace_id": {
            "type": "string"
          }
        }
      },
      "ChatToolCall": {
        "type": "object",
        "required": [
          "id",
          "name",
          "args",
          "approval_status",
          "execution_status"
        ],
        "properties": {
          "approval_status": {
            "type": "string"
          },
          "args": {},
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "execution_status": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "result": {}
        }
      },
      "CreateChatSession": {
        "type": "object",
        "required": [
          "workspace_id"
        ],
        "properties": {
          "model_config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ModelConfigBody",
                "description": "Session overrides. Omitted keys inherit the settings default."
              }
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "Omitted, null, or empty leaves the chat session unnamed. The model writes a\ntitle after the first turn. Longer than\n[`CHAT_SESSION_TITLE_MAX_CHARS`](crate::domain::chat_session::service::CHAT_SESSION_TITLE_MAX_CHARS)\nis rejected."
          },
          "workspace_id": {
            "type": "string"
          }
        }
      },
      "CreateWorkspace": {
        "type": "object",
        "required": [
          "root"
        ],
        "properties": {
          "root": {
            "type": "string",
            "description": "Absolute or relative directory. Stored as its canonical path."
          }
        }
      },
      "DecideToolCall": {
        "type": "object",
        "required": [
          "decision"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "description": "`approve` runs the call. `reject` refuses it."
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "description": "Shown to the model when `decision` is `reject`. Omitted uses a default."
          }
        }
      },
      "ModelConfigBody": {
        "type": "object",
        "description": "Stored session override. Absent keys inherit the settings default.",
        "properties": {
          "model": {
            "type": [
              "string",
              "null"
            ]
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "ModelConfigPatch": {
        "type": "object",
        "description": "One key of a session model override.\n\n`None` means the key was omitted. `Some(None)` clears it. `Some(Some)` sets it.",
        "properties": {
          "model": {
            "type": [
              "string",
              "null"
            ],
            "description": "Catalog model id. Null clears the session override."
          },
          "reasoning_effort": {
            "type": [
              "string",
              "null"
            ],
            "description": "`low`, `medium`, or `high`. Null clears the session override."
          }
        }
      },
      "SetSetting": {
        "type": "object",
        "required": [
          "value",
          "secret"
        ],
        "properties": {
          "secret": {
            "type": "boolean",
            "description": "When true, the value is written to the secrets file and later reads\nover HTTP omit it."
          },
          "value": {
            "type": "string"
          }
        }
      },
      "SettingResponse": {
        "type": "object",
        "required": [
          "key",
          "secret"
        ],
        "properties": {
          "key": {
            "type": "string"
          },
          "secret": {
            "type": "boolean"
          },
          "value": {
            "type": [
              "string",
              "null"
            ],
            "description": "`null` when the key is unset and has no default. Omitted when the stored value is a secret."
          }
        }
      },
      "SubmitInstruction": {
        "type": "object",
        "required": [
          "instruction"
        ],
        "properties": {
          "instruction": {
            "type": "string"
          }
        }
      },
      "UpdateChatSession": {
        "type": "object",
        "properties": {
          "model_config": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/ModelConfigPatch",
                "description": "Merge into the stored override. A null key clears that override. An omitted key stays."
              }
            ]
          },
          "path_allow_read": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Extra read-allow regexes, appended after the built-in list. The furthest match wins; at the same end byte, more literals win."
          },
          "path_allow_write": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Regexes. Ranked the same way as read allows. A parent match does not outrank a more specific write deny."
          },
          "path_deny_read": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Regexes matched against the workspace-relative path. A match denies a read."
          },
          "path_deny_write": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "description": "Regexes matched against the workspace-relative path. A match denies a write."
          },
          "title": {
            "type": [
              "string",
              "null"
            ],
            "description": "When set, replaces the title. Omitted leaves the stored title alone."
          }
        }
      },
      "Workspace": {
        "type": "object",
        "required": [
          "id",
          "name",
          "root",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "root": {
            "type": "string"
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "robi",
      "description": "Robi API"
    }
  ]
}
